---
const logos = [
  { src: "/assets/logos/velox.svg", alt: "Velox", w: 142, h: 34 },
  { src: "/assets/logos/roadlink.png", alt: "Road Link", w: 154, h: 56 },
  { src: "/assets/logos/pstc.png", alt: "Public Safety Towers", w: 154, h: 59 },
  { src: "/assets/logos/summitig.png", alt: "Summit IG", w: 156, h: 21 },
  { src: "/assets/logos/intrepid.png", alt: "Intrepid", w: 143, h: 37 },
  { src: "/assets/logos/rlm.png", alt: "RLM Underground", w: 117, h: 72 },
  { src: "/assets/logos/underline.png", alt: "Underline", w: 154, h: 62 },
  { src: "/assets/logos/sellenriek.png", alt: "Sellenriek Family of Companies", w: 156, h: 32 },
  { src: "/assets/logos/united-fiber.png", alt: "United Fiber", w: 155, h: 26 },
];
---
<section class="paper band" aria-label="Customers">
  <p class="claim"><span class="hl hl--stoplight">Powering &gt;$500M</span> of construction activity for the country’s best builders</p>
  <div class="marquee">
    <ul class="track">
      {[...logos, ...logos].map((l, i) => (
        <li class="cell" aria-hidden={i >= logos.length ? "true" : undefined}>
          <img src={l.src} alt={i < logos.length ? l.alt : ""} width={l.w} height={l.h} loading="lazy" />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .band { padding: 166px 0 47px; overflow: hidden; }
  .claim { text-align: center; font-size: var(--text-body); line-height: 1.3; letter-spacing: -0.2px; padding-inline: var(--gutter); }
  .marquee { margin-top: 24px; opacity: 0.7; }
  .track {
    display: flex; gap: 17px; width: max-content; margin: 0; padding: 0; list-style: none;
    animation: scroll 60s linear infinite;
  }
  .marquee:hover .track { animation-play-state: paused; }
  .cell { flex: none; width: 185px; height: 86px; display: grid; place-items: center; }
  .cell img { width: auto; height: auto; max-width: 156px; max-height: 72px; }
  @keyframes scroll { to { transform: translateX(calc(-50% - 8.5px)); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; justify-content: center; width: 100%; flex-wrap: wrap; } .cell[aria-hidden="true"] { display: none; } }
  @media (max-width: 900px) { .band { padding-top: 100px; } .claim { font-size: 17px; } }
</style>
