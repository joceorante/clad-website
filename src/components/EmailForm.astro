---
/* Email capture on light backgrounds: an outlined mono field plus the solid button (the footer's form, inverted).
   Not wired to anything yet; it posts nowhere until there is a signup endpoint. */
interface Props { id: string; placeholder?: string; button?: string; }
const { id, placeholder = "Work email", button = "Get started" } = Astro.props;
---
<form class="email" action="#" method="post" novalidate>
  <label class="sr-only" for={id}>{placeholder}</label>
  <input id={id} name="email" type="email" placeholder={placeholder} autocomplete="email" />
  <button class="btn btn--solid" type="submit">{button}</button>
</form>

<style>
  .email { display: flex; gap: 9px; width: min(100%, 560px); }
  input {
    flex: 1; min-width: 0; padding: 12px 24px; border-radius: var(--radius-md);
    border: 1px solid var(--color-tar); background: var(--color-paper); color: var(--color-tar);
    font-family: var(--font-mono); font-size: var(--text-ui); line-height: 30px; text-transform: uppercase;
  }
  input::placeholder { color: var(--color-tar); opacity: .45; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 520px) { .email { flex-direction: column; } }
</style>
