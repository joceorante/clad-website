---
const features = [
  { icon: "ads_click", color: "var(--color-orange)", title: "Track it all", desc: "Manage all of your work, from half-day drops to multi-month builds." },
  { icon: "assignment", color: "var(--color-stoplight)", title: "Stop over-billing", desc: "Tie subcontractor bills to production, eliminating the risk of over-paying your vendors." },
  { icon: "analytics", color: "var(--color-cobalt)", title: "Scale your back-office", desc: "AI to submit and track locates. Build custom reports and dashboards." },
  { icon: "receipt_long", color: "var(--color-lilac)", title: "Get paid faster", desc: "Reduce DSO by generating invoices and as-builts in minutes." },
];
---
<section class="container cases" id="use-cases">
  <span class="pill label">use cases</span>
  <div class="tabs" role="tablist" aria-label="Use cases">
    <button role="tab" aria-selected="true" class="tab is-active">Contractors</button>
    <button role="tab" aria-selected="false" class="tab">Asset Owners</button>
    <span class="indicator" aria-hidden="true"></span>
  </div>
  <p class="sub">Supporting companies from <span class="hl hl--tar">$1 to +$100M</span> of revenue.</p>
  <ul class="grid"-group="90">
    {features.map((f) => (
      <li class="card">
        <div class="icon" style={`background:${f.color}`}><img src={`/assets/icons/${f.icon}.svg`} alt="" width="34" height="34" /></div>
        <div class="text">
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .cases { margin-top: 98px; }
  .label { background: var(--color-paper-dim); }
  .tabs { position: relative; display: flex; gap: 36px; margin-top: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--color-rule-light); }
  .tab { font-family: var(--font-display); font-size: var(--text-h2); line-height: 1.2; letter-spacing: -0.5px; font-weight: 600; opacity: 0.3; transition: opacity .15s; }
  .tab.is-active, .tab:hover { opacity: 1; }
  .indicator { position: absolute; left: 0; bottom: -1px; width: 230px; height: 3px; background: var(--color-tar); }
  .sub { margin-top: 36px; font-size: var(--text-body); line-height: 1.3; letter-spacing: -0.2px; }
  .grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin: 36px 0 0; padding: 0; list-style: none; }
  .card {
    display: flex; flex-direction: column; gap: 24px; min-height: 269px; padding: 20px;
    border: var(--hairline) solid var(--color-tar); border-radius: var(--radius-md);
  }
  .icon { width: 64px; height: 64px; border-radius: var(--radius-sm); display: grid; place-items: center; }
  .icon img { width: 34px; height: 34px; }
  .text { display: flex; flex-direction: column; gap: 8px; }
  .text h3 { font-size: var(--text-body); line-height: 1.3; font-weight: 700; letter-spacing: -0.2px; }
  .text p { font-size: var(--text-sm); line-height: 1.5; letter-spacing: -0.14px; }
  @media (max-width: 1000px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 900px) { .cases { margin-top: 64px; } .tabs { gap: 20px; } .indicator { width: 150px; } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } .card { min-height: 0; } }
</style>
