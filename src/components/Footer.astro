---
const stripes = ["cobalt", "cobalt", "lilac", "lilac", "orange", "orange", "stoplight", "stoplight"];
const colA = [["Locates", "#locates"], ["Changelog", "#changelog"], ["Blog", "#blog"], ["About", "#about"]];
const colB = [["Login", "#login"], ["Terms of service", "#terms"], ["Privacy policy", "#privacy"]];
---
<footer class="footer" id="demo">
  <div class="top">
    <div class="container cta">
      <h2>Upgrade your project’s operations and finances today</h2>
      <p class="sub">Get a custom demo, explore plans &amp; pricing for your company.</p>
      <form class="form" action="#" method="post" novalidate>
        <label class="sr-only" for="footer-email">Email address</label>
        <input id="footer-email" name="email" type="email" placeholder="EMAIL ADDRESS" autocomplete="email" />
        <button class="btn btn--light" type="submit">Book demo</button>
      </form>
    </div>
  </div>
  <div class="stripes" aria-hidden="true">
    {stripes.map((c) => <span style={`background:var(--color-${c})`}></span>)}
  </div>
  <div class="bottom">
    <div class="container-wide row">
      <div class="brand">
        <img src="/assets/clad-logo-footer.svg" alt="Clad" width="158" height="52" />
        <p>Project management and billing software purpose-built for infrastructure.</p>
      </div>
      <nav class="links" aria-label="Footer">
        <ul>{colA.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
        <ul>{colB.map(([l, h]) => <li><a href={h}>{l}</a></li>)}</ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer { background: var(--color-tar); color: var(--color-paper); }
  .top { border-top: var(--hairline) solid var(--color-grid); }
  .cta { border-left: 1px solid var(--color-grid); border-right: 1px solid var(--color-grid); padding: 101px var(--gutter) 91px; text-align: center; }
  .cta h2 { font-size: var(--text-h2-footer); line-height: 1.2; letter-spacing: -0.5px; max-width: 714px; margin-inline: auto; }
  .sub { margin-top: 35px; font-size: var(--text-body); line-height: 1.3; letter-spacing: -0.2px; }
  .form { display: flex; gap: 13px; justify-content: center; margin-top: 27px; }
  .form input {
    width: 430px; max-width: 100%; padding: 12px 24px; border-radius: var(--radius-md);
    border: 1px solid var(--color-paper); background: transparent; color: var(--color-paper);
    font-family: var(--font-mono); font-size: var(--text-ui); line-height: 30px; text-transform: uppercase;
  }
  .form input::placeholder { color: var(--color-paper); opacity: 1; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .stripes { display: flex; flex-direction: column; gap: 3.35px; overflow: hidden; }
  .stripes span { display: block; height: 15.93px; width: 110%; margin-left: -5%; border-radius: 28px; transform-origin: left center; }
  /* cascade: once JS arms the block, each stripe sweeps in from the left, staggered top to bottom */
  .stripes.is-armed span { transform: scaleX(0); transition: transform .9s cubic-bezier(.2,.7,.2,1); }
  .stripes.is-armed span:nth-child(2) { transition-delay: .08s; } .stripes.is-armed span:nth-child(3) { transition-delay: .16s; } .stripes.is-armed span:nth-child(4) { transition-delay: .24s; }
  .stripes.is-armed span:nth-child(5) { transition-delay: .32s; } .stripes.is-armed span:nth-child(6) { transition-delay: .40s; } .stripes.is-armed span:nth-child(7) { transition-delay: .48s; } .stripes.is-armed span:nth-child(8) { transition-delay: .56s; }
  .stripes.is-armed.is-in span { transform: scaleX(1); }
  .bottom { background: url("/assets/grid-footer.svg") -182px -984px / 1819px 1816px no-repeat; }
  .row { display: flex; justify-content: space-between; align-items: flex-start; gap: 40px; padding: 159px 0 141px; }
  .brand { width: 315px; max-width: 100%; }
  .brand img { width: 158px; height: 52px; }
  .brand p { margin-top: 18.7px; font-size: 16.24px; line-height: 1.3; letter-spacing: -0.16px; }
  .links { display: flex; gap: 41px; }
  .links ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 15px; }
  .links a { font-family: var(--font-mono); font-size: 14.6px; line-height: 1.2; letter-spacing: 0.05em; text-transform: uppercase; text-decoration: none; }
  .links a:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 900px) {
    .cta { padding: 64px var(--gutter) 56px; border: 0; }
    .sub { margin-top: 20px; font-size: 17px; }
    .form { flex-direction: column; align-items: stretch; } .form input { width: 100%; }
    .row { flex-direction: column; padding: 80px 0 72px; background-position: -600px -700px; }
  }
</style>

<script>
  const stripes = document.querySelector<HTMLElement>(".footer .stripes");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (stripes && !reduce && "IntersectionObserver" in window) {
    stripes.classList.add("is-armed");
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { stripes.classList.add("is-in"); io.disconnect(); }
    }, { threshold: 0.4 });
    io.observe(stripes);
  }
</script>
