><line class="dot bg" x1="0.0" y1="238.3" x2="0.0" y2="238.3" style="--i:0"/><line class="dot" x1="0.0" y1="238.3" x2="0.0" y2="238.3" style="stroke:#f2c230;--i:0"/><line class="dot bg" x1="120.0" y1="186.3" x2="120.0" y2="186.3" style="--i:1"/><line class="dot" x1="120.0" y1="186.3" x2="120.0" y2="186.3" style="stroke:#f2c230;--i:1"/><line class="dot bg" x1="240.0" y1="216.7" x2="240.0" y2="216.7" style="--i:2"/><line class="dot" x1="240.0" y1="216.7" x2="240.0" y2="216.7" style="stroke:#f2c230;--i:2"/><line class="dot bg" x1="360.0" y1="156.0" x2="360.0" y2="156.0" style="--i:3"/><line class="dot" x1="360.0" y1="156.0" x2="360.0" y2="156.0" style="stroke:#f2c230;--i:3"/><line class="dot bg" x1="480.0" y1="182.0" x2="480.0" y2="182.0" style="--i:4"/><line class="dot" x1="480.0" y1="182.0" x2="480.0" y2="182.0" style="stroke:#f2c230;--i:4"/><line class="dot bg" x1="600.0" y1="234.0" x2="600.0" y2="234.0" style="--i:5"/><line class="dot" x1="600.0" y1="234.0" x2="600.0" y2="234.0" style="stroke:#f2c230;--i:5"/><g class="fcast"><polyline class="fline" points="600.0,30.3 720.0,21.7 840.0,8.7" style="stroke:#3cb043"/><polyline class="fline" points="600.0,164.7 720.0,143.0 840.0,125.7" style="stroke:#e5533c"/><polyline class="fline" points="600.0,234.0 720.0,212.3 840.0,195.0" style="stroke:#f2c230"/></g></svg><div class="xlab"><span>Mar 2</span><span>Mar 16</span><span>Mar 30</span><span class="fx">Apr 20</span></div></div></div></div></div>
    </div>
  </section>
  <section class="scene" id="story-locates" data-scene="locates">
    <div class="pin">
      <div class="head">
        <span class="label">Locates</span>
        <h3>Automate your 811 tickets</h3>
        <p class="sub">AI 811 ticket management to submit and track your locate requests</p>
        <a class="more" href="#locates">Learn more <span aria-hidden="true">›</span></a>
        <ul class="feats"><li data-step="0" class=is-active><button type="button"><b>AI ticket submission</b><span>Use AI to create and submit 811 tickets in bulk</span></button></li><li data-step="1"><button type="button"><b>Automated tracking and renewals</b><span>Visualize ticket status and keep tickets updated from a single dashboard</span></button></li><li data-step="2"><button type="button"><b>Subcontractor visibility</b><span>Monitor your subcontractors’ 811 tickets</span></button></li></ul>
      </div>
      <div class="stage"><div class="act" data-a="form"><div class="card aiform"><div class="ahd"><i class="spark" aria-hidden="true"></i><b>New locate ticket</b><span>Drafted by Clad AI from your work order</span></div><div class="fld" style="--i:0"><span>Address</span><em><span class="type">1420 Maple Run Rd, Suffolk, VA</span></em></div><div class="fld" style="--i:1"><span>Work type</span><em><span class="type">Directional boring · 1.25” conduit</span></em></div><div class="fld" style="--i:2"><span>Dig start</span><em><span class="type">Mon, Sep 28</span></em></div><div class="cta"><span class="btn2 primary submit">Submit to 811</span><span class="sent"><i></i>Submitted · Ticket 2609-2211-04</span></div></div></div><div class="act" data-a="tickets"><div class="card tickets"><div class="chd"><b>Locate tickets</b><span class="filter"><em class="fa">Acme Fiber</em><em class="fb">All subcontractors</em></span></div><div class="lth"><span>Ticket</span><span>Company</span><span>Status</span><span>Expires</span></div><div class="rows"><div class="grp a"><div class="row" style="--j:0"><span class="tk"><b>1420 Maple Run Rd</b><small>2609-2211-04</small></span><span class="who co"><i>AF</i>Acme Fiber</span><span class="st"><em class="spill info a">Submitted</em><em class="spill ok b">Cleared</em></span><span class="ex">Oct 12</span></div><div class="row" style="--j:1"><span class="tk"><b>Hwy 9 & Mill Rd</b><small>2609-2208-02</small></span><span class="who co"><i>AF</i>Acme Fiber</span><span class="st"><em class="spill warn a">Expires Fri</em><em class="spill ok b">Renewed</em></span><span class="ex">Oct 24</span></div><div class="row" style="--j:2"><span class="tk"><b>71 Riverside Dr</b><small>2609-2207-11</small></span><span class="who co"><i>AF</i>Acme Fiber</span><span class="st"><em class="spill warn a">Pending</em><em class="spill ok b">Cleared</em></span><span class="ex">Oct 3</span></div></div><div class="grp b"><div class="row" style="--i:0"><span class="tk"><b>388 Cedar Loop</b><small>2609-2210-17</small></span><span class="who co"><i>OU</i>Ortiz Underground</span><span class="st"><em class="spill ok ">Cleared</em></span><span class="ex">Oct 9</span></div><div class="row" style="--i:1"><span class="tk"><b>902 Main St</b><small>2609-2205-06</small></span><span class="who co"><i>KC</i>Kline Civil</span><span class="st"><em class="spill warn ">Pending</em></span><span class="ex">Oct 1</span></div><div class="row" style="--i:2"><span class="tk"><b>14 Harbor Way</b><small>2609-2212-09</small></span><span class="who co"><i>BB</i>Bell Boring</span><span class="st"><em class="spill info ">Submitted</em></span><span class="ex">Oct 15</span></div></div></div></div></div></div>
    </div>
  </section>
</div>

<script src="../scripts/story.js"></script>

<style is:global>
  /* ---------- layout: copy + stacked features on the left, stage on the right, centered under the nav ---------- */
  .story { margin-top: 148px; margin-bottom: 86px; }
  .story .scene { position: relative; height: 420vh; }
  .story .pin {
    position: sticky; top: 72px; height: calc(100vh - 72px);
    display: grid; grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .story .head { display: flex; flex-direction: column; gap: 14px; }
  .story .head .label { font-family: var(--font-mono); font-size: 15px; font-weight: 700; letter-spacing: .75px; text-transform: uppercase; color: var(--color-cobalt); line-height: 1.2; }
  .story .head h3 { font-size: var(--text-h2); line-height: 1.15; letter-spacing: -1.5px; font-weight: 600; }
  .story .head .sub { font-size: 18px; line-height: 1.4; letter-spacing: -0.2px; max-width: 34ch; }
  .story .more { align-self: flex-start; font-family: var(--font-mono); font-size: 13px; letter-spacing: .08em; text-transform: uppercase; text-decoration: none; color: var(--color-tar); }
  .story .more:hover { text-decoration: underline; text-underline-offset: 4px; }

  /* stacked features: dim by default, the current step at full strength */
  .story .feats { display: flex; flex-direction: column; margin: 18px 0 0; padding: 0; list-style: none; }
  .story .feats li { opacity: .3; transition: opacity .35s ease; }
  .story .feats li.is-active { opacity: 1; }
  .story .feats button { display: flex; flex-direction: column; gap: 4px; width: 100%; padding: 14px 0 14px 20px; text-align: left; border-left: 2px solid rgb(37 34 12 / .18); transition: border-color .35s ease; }
  .story .feats li.is-active button { border-left-color: var(--color-tar); }
  .story .feats button:hover { opacity: 1; }
  .story .feats b { font-size: 17px; font-weight: 600; letter-spacing: -0.2px; line-height: 1.3; }
  .story .feats span { font-size: 14px; line-height: 1.45; letter-spacing: -0.1px; max-width: 40ch; }

  .story .stage {
    position: relative; justify-self: center; width: min(100%, calc((100vh - 72px - 96px) * 1.2)); aspect-ratio: 6 / 5;
    container-type: inline-size; font-size: clamp(8px, 1.75cqw, 14px); color: #1f1f1f; letter-spacing: 0; line-height: 1.3;
  }
  .story .act { position: absolute; translate: -50% -50%; transform-origin: center; }

  /* ---------- shared card chrome ("Mocks Drop Shadow" from Figma) ---------- */
  .story .card { background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 0 0 1px rgb(0 0 0 / .12), 0 0 2px rgb(0 0 0 / .08), 0 2px 6px rgb(0 0 0 / .1), 0 18px 40px -24px rgb(37 34 12 / .35); }
  .story .chd { display: flex; align-items: baseline; gap: .8em; padding: 1.1em 1.3em; border-bottom: 1px solid #efefed; }
  .story .chd b { font-size: 1.2em; font-weight: 600; letter-spacing: -.01em; }
  .story .chd span { color: #8a8a86; }
  .story .row { border-bottom: 1px solid #f1f1ef; }
  .story .row:last-child { border-bottom: 0; }
  .story .who { display: inline-flex; align-items: center; gap: .5em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .story .who i { flex: none; width: 1.9em; height: 1.9em; border-radius: 50%; background: #ececea; color: #555; font-size: .72em; font-weight: 600; font-style: normal; display: grid; place-items: center; }
  .story .who.co i { border-radius: .35em; background: #e9e6ff; color: #4750ff; }
  .story .btn2 { display: inline-flex; align-items: center; height: 2.8em; padding: 0 1.3em; border: 1px solid #e3e3e0; border-radius: .55em; background: #fff; white-space: nowrap; }
  .story .btn2.primary { background: var(--color-cobalt); border-color: var(--color-cobalt); color: #fff; }

  /* ---------- billing: daily updates ---------- */
  .story .updates .row { padding: .9em 1.3em; display: flex; flex-direction: column; gap: .45em; }
  .story .updates .l1, .story .updates .l2 { display: flex; align-items: center; gap: .9em; }
  .story .updates .item { flex: 1; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .story .updates .item em, .story .invoice .item em { font-style: normal; color: #9a9a96; font-weight: 400; }
  .story .updates .qty { font-weight: 600; font-variant-numeric: tabular-nums; }
  .story .updates .date { color: #8a8a86; min-width: 6.2em; }
  .story .updates .att { margin-left: auto; display: flex; gap: .35em; }
  .story .updates .att i { font-style: normal; font-size: .7em; font-weight: 600; letter-spacing: .04em; padding: .25em .45em; border: 1px solid #ddd; border-radius: .3em; color: #6f6f6b; }
  /* rows roll in from the left one at a time as --draw goes 0 -> 1 */
  .story .updates .row { --k: clamp(0, calc((var(--draw, 0) - var(--i) * .3) * 4), 1); opacity: var(--k); transform: translateX(calc((1 - var(--k)) * -2.4em)); }

  /* ---------- billing: invoice ---------- */
  .story .invoice { padding: 1.3em 1.5em 1.2em; }
  .story .vhd { display: flex; justify-content: space-between; align-items: flex-start; gap: 1em; }
  .story .vhd b { display: block; font-size: 1.45em; font-weight: 700; letter-spacing: -.01em; }
  .story .vhd span { color: #8a8a86; }
