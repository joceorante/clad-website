---
/* Product story: three pinned scenes (Billing, Project Management, Locates), each three scroll steps.
   GENERATED by reference/gen_story.py; styles in reference/story.css. Edit those, not this file. */
---
<div class="story container-wide" id="story" aria-label="How Clad works">
  <section class="scene" id="story-billing" data-scene="billing">
    <div class="pin">
      <div class="head">
        <span class="label">Billing</span>
        <h3>Bill accurately</h3>
        <p class="sub">One system to prevent over- and under-billing</p>
        
        <ul class="feats"><li data-step="0" class=is-active><button type="button"><b>Production tracking</b><span>Collect daily production and documentation from the field</span></button></li><li data-step="1"><button type="button"><b>Linked invoices & bills</b><span>Tie your invoices and bills directly to approved production, so you only bill for work that’s done</span></button></li><li data-step="2"><button type="button"><b>QBO integration</b><span>Sync invoices with QuickBooks to speed up AR accounting and track retainage</span></button></li></ul>
      </div>
      <div class="stage"><div class="act" data-a="updates"><div class="card updates"><div class="chd"><b>Daily updates</b><span>Maple Run · Week of Sep 14</span></div><div class="row" style="--i:0"><div class="l1"><span class="item"><em>D02</em> Mount NID at service address</span><span class="qty">24 EA</span></div><div class="l2"><span class="date">Mon Sep 14</span><span class="who person"><i>DA</i>D. Alvarez</span><span class="att"><i>IMG</i><i>IMG</i></span></div></div><div class="row" style="--i:1"><div class="l1"><span class="item"><em>D03</em> UG pull fiber drop</span><span class="qty">180 LF</span></div><div class="l2"><span class="date">Tue Sep 15</span><span class="who co"><i>OU</i>Ortiz Underground</span><span class="att"><i>PDF</i></span></div></div><div class="row" style="--i:2"><div class="l1"><span class="item"><em>GT-CON01</em> 1.25” Conduit</span><span class="qty">271 LF</span></div><div class="l2"><span class="date">Wed Sep 16</span><span class="who co"><i>BB</i>Bell Boring</span><span class="att"><i>IMG</i></span></div></div></div></div><div class="act" data-a="invoice"><div class="card invoice"><div class="vhd"><div><b>Invoice #487</b><span>Big TelCo · Suffolk, VA - Z1.4</span></div><span class="logo">ACME</span></div><div class="vdue"><span data-count="money">$0.00</span><small>due Oct 1, 2026</small></div><div class="vth"><span>Description</span><span>Qty</span><span>Amount</span></div><div class="row" style="--i:0"><span class="item"><em>D02</em> Mount NID at service address<small>Linked to Mon Sep 14 update</small></span><span>24</span><span>$290.88</span></div><div class="row" style="--i:1"><span class="item"><em>D03</em> UG pull fiber drop<small>Linked to Tue Sep 15 update</small></span><span>180</span><span>$1,530.00</span></div><div class="row" style="--i:2"><span class="item"><em>GT-CON01</em> 1.25” Conduit<small>Linked to Wed Sep 16 update</small></span><span>271</span><span>$2,200.52</span></div><div class="vtot"><span>Amount due</span><b data-count="money">$0.00</b></div></div></div><div class="act" data-a="qb"><div class="qbchip"><span class="qbi" aria-hidden="true">qb</span><span class="txt"><b>Synced to QuickBooks</b><small>Invoice #487 · just now</small></span><span class="ok" aria-hidden="true"></span></div></div></div>
    </div>
  </section>
  <section class="scene" id="story-pm" data-scene="pm">
