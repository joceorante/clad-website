---
/* Product story: three scroll-scrubbed scenes (Capture, Manage, Bill) built from the Figma
   "Start state" / "End state" frames. GENERATED by reference/gen_story.py; edit the generator. */
---
<div class="story container-wide" id="story" aria-label="How Clad works">
  <section class="scene" id="story-capture" data-scene="capture">
    <div class="pin">
      <div class="head">
        <span class="label">Capture</span>
        <h3>Record everything you need from the field in a single place</h3>
      </div>
      <div class="stage"><div class="act skin" data-a="sketch"><figure class="mock photo"><img src="/assets/story/capture-sketch.png" alt="Handwritten field sketch on paper" /></figure><figure class="mock photo"><img src="/assets/story/capture-map.png" alt="Clad field map with a redlined bore and its quantity form" /></figure></div><div class="act skin" data-a="sheet"><figure class="mock photo"><img src="/assets/story/capture-spreadsheet.png" alt="Concrete volume and cost spreadsheet" /></figure><figure class="mock photo"><img src="/assets/story/capture-production.png" alt="Clad production table with budgeted, progress to date and item quantities" /></figure></div><div class="act" data-a="gmail"><div class="gmail"><figure class="mock icon"><img src="/assets/story/capture-gmail.png" alt="Gmail" /></figure><span class="badge">8,201</span></div></div></div>
    </div>
  </section>
  <section class="scene" id="story-manage" data-scene="manage">
    <div class="pin">
      <div class="head">
        <span class="label">Manage</span>
        <h3>Connect the dots on all the projects you manage</h3>
      </div>
      <div class="stage"><div class="act" data-a="kanban"><figure class="mock app"><img src="/assets/story/manage-kanban.png" alt="Clad project board: Not Started, Permitting, Make Ready, Construction" /></figure></div><div class="act" data-a="chart"><figure class="mock photo"><img src="/assets/story/manage-chart.png" alt="Weekly production report line chart across five projects" /></figure></div></div>
    </div>
  </section>
  <section class="scene" id="story-bill" data-scene="bill">
    <div class="pin">
      <div class="head">
        <span class="label">Bill</span>
        <h3>Generate accurate invoices and eliminate over- or under-billing</h3>
      </div>
      <div class="stage"><div class="act" data-a="items"><figure class="mock photo"><img src="/assets/story/bill-items.png" alt="Invoice line items being entered by hand" /></figure></div><div class="act" data-a="invoice"><figure class="mock photo"><img src="/assets/story/bill-invoice.png" alt="Finished invoice, $10,419.60 due October 1, 2026" /></figure></div></div>
    </div>
  </section>
</div>

<script src="../scripts/story.js"></script>

<style is:global>
  .story { margin-top: 148px; margin-bottom: 86px; }
  .story .scene { position: relative; height: 300vh; }
  .story .pin {
    position: sticky; top: calc(72px + 20px); height: calc(100vh - 72px - 40px);
    display: flex; flex-direction: column; gap: 28px;
  }
  .story .head { display: flex; flex-direction: column; gap: 14px; }
  .story .head .label { font-family: var(--font-mono); font-size: 15px; font-weight: 700; letter-spacing: .75px; text-transform: uppercase; color: var(--color-cobalt); line-height: 1.2; }
  .story .head h3 { font-size: var(--text-h2); line-height: 1.2; letter-spacing: -1.5px; font-weight: 600; max-width: 650px; }
  .story .stage {
    position: relative; flex: 1; min-height: 0; overflow: visible;
    aspect-ratio: 16 / 9; width: auto; max-width: 100%; align-self: center;
  }
  .story .act { position: absolute; transform-origin: center; }
  .story .skin .mock { position: absolute; inset: 0; }
  .story .skin .mock + .mock { opacity: 0; }
  .story .mock { margin: 0; width: 100%; height: 100%; overflow: hidden; background: var(--color-paper); }
  .story .mock img { width: 100%; height: 100%; object-fit: cover; display: block; }
  /* "Mocks Drop Shadow" from Figma, two frame styles */
  .story .mock.photo { border: 8px solid #fff; border-radius: 4px; box-shadow: 0 0 0 1px rgb(0 0 0 / .2), 0 0 2px rgb(0 0 0 / .08), 0 2px 6px rgb(0 0 0 / .1); }
  .story .mock.app { border-radius: 10px; box-shadow: 0 0 4px rgb(0 0 0 / .25), 0 2px 6px rgb(0 0 0 / .1), 0 0 2px rgb(0 0 0 / .08); }
  .story .mock.icon { border: 1.25px solid #eee; border-radius: 27.5%; box-shadow: 0 0 5px rgb(0 0 0 / .25), 0 2.5px 7.5px rgb(0 0 0 / .1), 0 0 2.5px rgb(0 0 0 / .08); }
  .story .mock.icon img { object-fit: contain; padding: 6%; }
  .story .gmail { position: relative; width: 100%; height: 100%; }
  .story .gmail .badge { position: absolute; right: -10%; top: -14%; background: #ea3939; color: #fff; border-radius: 999px; padding: .35em .9em; font-size: clamp(9px, 1.05cqw, 12.5px); line-height: 1.2; }
  .story .stage { container-type: size; }
  @media (max-width: 900px) {
    .story { margin-top: 72px; margin-bottom: 56px; }
    .story .scene { height: 240vh; }
    .story .pin { top: calc(64px + 12px); height: calc(100vh - 64px - 24px); gap: 16px; justify-content: flex-start; }
    .story .head h3 { font-size: 26px; letter-spacing: -.5px; }
    .story .stage { flex: none; width: 100%; height: auto; }
    .story .mock.photo { border-width: 4px; }
  }
</style>
