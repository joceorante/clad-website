---
/* Closing CTA, in the homepage CtaBanner's style with the email form. Copy is from the current Locates page. */
import EmailForm from "../EmailForm.astro";
---
<section class="hairline-y cta">
  <div class="container inner">
    <p class="copy"><strong>Ready to get started?</strong> <br />Tell us where you work and get started with Clad Locates.</p>
    <EmailForm id="cta-email" />
  </div>
</section>

<style>
  .cta { padding: 75px 0; }
  .inner { display: flex; align-items: center; justify-content: space-between; gap: 40px; }
  .copy { font-size: var(--text-h2); line-height: 1.2; letter-spacing: -1.5px; max-width: 640px; }
  .copy strong { font-weight: 600; }
  .inner :global(.email) { width: min(100%, 460px); flex: none; }
  @media (max-width: 1100px) { .inner { flex-direction: column; align-items: flex-start; gap: 28px; } }
  @media (max-width: 900px) { .cta { padding: 48px 0; } .copy br { display: none; } }
</style>
