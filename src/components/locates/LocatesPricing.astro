---
/* Locates pricing: ticket-volume slider and three plans. Copy, features and prices are from Clad's current pricing page
   (Jocelyn's screenshots, 2026-10-14). Only the 50 and 500 ticket stops showed prices; every other stop is null and
   renders as [TBD] until Jason sends the full table. Fill in PRICES, never guess a number. */
const STOPS = [50, 100, 200, 300, 400, 500, 1000, 2000];
type Price = { standard: number; standardExtra: number; pro: number; proExtra: number } | null;
const PRICES: Record<number, Price> = {
  50: { standard: 250, standardExtra: 5, pro: 450, proExtra: 9 },
  100: null, 200: null, 300: null, 400: null,
  500: { standard: 1500, standardExtra: 3, pro: 2500, proExtra: 5 },
  1000: null, 2000: null,
};
const START = 0;  // slider starts at 50 tickets

const plans = [
  { id: "free", name: "Free", cta: ["Get started", "#demo"], features: ["1 state limit", "AI ticket creation", "Automated status tracking", "Map view"] },
  { id: "standard", name: "Standard", featured: true, cta: ["Get started", "#demo"], features: ["Everything in Free", "Unlimited states", "Automated ticket renewals", "Expiring ticket notifications", "Photo and file attachments", "Bulk address upload", "All ticket types", "Submit no-response notices"] },
  { id: "pro", name: "Pro", cta: ["Contact us", "#demo"], features: ["Everything in Standard", "KMZ-to-ticket tool", "API access", "SSO (additional add-on)", "Custom integrations", "Custom reports"] },
];
const n = new Intl.NumberFormat("en-US");
const label = (t: number) => (t === 2000 ? "2,000+" : n.format(t));
const p0 = PRICES[STOPS[START]];
const price = (v: number | undefined) => (v == null ? "[TBD]" : `$${n.format(v)}`);
const extra = (v: number | undefined) => (v == null ? "[TBD]" : `$${v.toFixed(2)}`);
---
<section class="container pricing">
  <header class="head">
    <h1>Pricing</h1>
    <p>Start for free and scale as your ticket volume grows.</p>
  </header>

  <div class="volume">
    <label class="vlabel" for="ticket-volume">Number of tickets per month</label>
    <div class="slider" style={`--p:${(START / (STOPS.length - 1)) * 100}%`}>
      <input id="ticket-volume" type="range" min="0" max={STOPS.length - 1} step="1" value={START} aria-valuetext={`${label(STOPS[START])} tickets`} />
      <ol class="ticks" aria-hidden="true">
        {STOPS.map((t, i) => <li style={`--i:${i}`} class:list={{ on: i === START }} data-i={i}>{label(t)}</li>)}
      </ol>
    </div>
  </div>

  <div class="plans">
    {plans.map((p) => (
      <article class:list={["plan", { featured: p.featured }]} data-plan={p.id}>
        <div class="top">
          <h2 class="t-label">{p.name}</h2>
          {p.featured && <span class="badge mono">Recommended</span>}
        </div>
        <p class="price">
          <b data-price>{p.id === "free" ? "$0" : price(p.id === "standard" ? p0?.standard : p0?.pro)}</b><span>/ mo</span>
        </p>
        <div class="vol">
          <p data-tickets>{p.id === "free" ? "20" : label(STOPS[START])} tickets per month</p>
          {p.id !== "free" && <p class="muted">Extra tickets: <span data-extra>{extra(p.id === "standard" ? p0?.standardExtra : p0?.proExtra)}</span> each</p>}
        </div>
        <ul class="feats">
          {p.features.map((f) => (
            <li><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.4 6.6 11.4 12.5 4.8" /></svg>{f}</li>
          ))}
        </ul>
        <a class:list={["btn", { "btn--solid": p.featured }]} href={p.cta[1]}>{p.cta[0]}</a>
      </article>
    ))}
  </div>
  <script type="application/json" id="pricing-data" set:html={JSON.stringify({ STOPS, PRICES })} />
</section>

<style>
  .pricing { padding: 72px 0 120px; }
  .head { text-align: center; }
  h1 { font-size: var(--text-display); line-height: 1.02; letter-spacing: -1.5px; }
  .head p { margin-top: 20px; font-size: var(--text-body); line-height: 1.3; }

  /* volume slider: tar fill on a light track, ticks positioned to line up with the thumb's travel */
  .volume { display: flex; flex-direction: column; align-items: center; gap: 22px; margin-top: 64px; }
  .vlabel { font-size: 17px; line-height: 1.3; font-weight: 600; letter-spacing: -0.2px; }
  .slider { --r: 11px; position: relative; width: min(100%, 720px); padding-bottom: 30px; }
  input { -webkit-appearance: none; appearance: none; display: block; width: 100%; height: 22px; margin: 0; background: transparent; cursor: pointer; }
  input::-webkit-slider-runnable-track { height: 4px; border-radius: 99px; background: linear-gradient(to right, var(--color-tar) var(--p), #e3e2dc var(--p)); }
  input::-moz-range-track { height: 4px; border-radius: 99px; background: linear-gradient(to right, var(--color-tar) var(--p), #e3e2dc var(--p)); }
  input::-webkit-slider-thumb { -webkit-appearance: none; width: 22px; height: 22px; margin-top: -9px; border-radius: 50%; background: var(--color-stoplight); border: 1.5px solid var(--color-tar); }
  input::-moz-range-thumb { width: 22px; height: 22px; border-radius: 50%; background: var(--color-stoplight); border: 1.5px solid var(--color-tar); box-sizing: border-box; }
  .ticks { position: absolute; left: 0; right: 0; top: 34px; margin: 0; padding: 0; list-style: none; }
  .ticks li { position: absolute; left: calc(var(--r) + (100% - 2 * var(--r)) * var(--i) / 7); translate: -50% 0; font-family: var(--font-mono); font-size: 13px; color: #8a8a86; white-space: nowrap; cursor: pointer; }
  .ticks li.on { color: var(--color-tar); font-weight: 700; }

  /* plans: hairline cards; the recommended plan gets the tar outline and a Stoplight badge */
  .plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 64px; align-items: stretch; }
  .plan { display: flex; flex-direction: column; padding: 32px 28px 28px; border: 1px solid #dddcd6; border-radius: 16px; background: var(--color-paper); }
  .plan.featured { border-color: var(--color-tar); box-shadow: inset 0 0 0 .5px var(--color-tar); }
  .top { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 28px; }
  .badge { padding: 4px 10px; border-radius: var(--radius-xs); background: var(--color-stoplight); font-size: 12px; font-weight: 700; }
  .price { display: flex; align-items: baseline; gap: 8px; margin-top: 28px; padding-bottom: 28px; border-bottom: 1px solid #dddcd6; }
  .price b { font-size: var(--text-h2); line-height: 1.1; letter-spacing: -1.5px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .price span { font-size: var(--text-body); color: #6f6e66; }
  .vol { min-height: 92px; padding: 22px 0; border-bottom: 1px solid #dddcd6; font-size: 17px; line-height: 1.4; }
  .vol .muted { margin-top: 2px; font-size: 15px; color: #6f6e66; }
  .feats { display: flex; flex-direction: column; gap: 14px; margin: 24px 0 32px; padding: 0; list-style: none; flex: 1; }
  .feats li { display: flex; align-items: flex-start; gap: 10px; font-size: 16px; line-height: 1.4; }
  .feats svg { flex: none; width: 18px; height: 18px; margin-top: 2px; fill: none; stroke: var(--color-tar); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .plan .btn { width: 100%; }

  @media (max-width: 1000px) { .plans { grid-template-columns: 1fr; max-width: 520px; margin-inline: auto; } }
  @media (max-width: 900px) {
    .pricing { padding: 40px 0 72px; }
    .head p { font-size: 17px; }
    .volume { margin-top: 40px; }
    .ticks li { font-size: 10.5px; }
    .ticks li:first-child { translate: calc(-1 * var(--r)) 0; }  /* keep the end labels inside the column */
    .ticks li:last-child { translate: calc(-100% + var(--r)) 0; }
    .plans { margin-top: 44px; }
    .plan { padding: 26px 22px 22px; }
  }
</style>

<script>
  type Price = { standard: number; standardExtra: number; pro: number; proExtra: number } | null;
  const root = document.querySelector<HTMLElement>(".pricing");
  const data = document.getElementById("pricing-data");
  if (root && data) {
    const { STOPS, PRICES } = JSON.parse(data.textContent || "{}") as { STOPS: number[]; PRICES: Record<string, Price> };
    const input = root.querySelector<HTMLInputElement>("#ticket-volume")!;
    const slider = root.querySelector<HTMLElement>(".slider")!;
    const ticks = Array.from(root.querySelectorAll<HTMLElement>(".ticks li"));
    const n = new Intl.NumberFormat("en-US");
    const label = (t: number) => (t === 2000 ? "2,000+" : n.format(t));
    const money = (v: number | undefined) => (v == null ? "[TBD]" : `$${n.format(v)}`);
    const extra = (v: number | undefined) => (v == null ? "[TBD]" : `$${v.toFixed(2)}`);
    const set = (plan: string, sel: string, text: string) => { const el = root.querySelector(`[data-plan="${plan}"] ${sel}`); if (el) el.textContent = text; };
    const update = () => {
      const i = +input.value, t = STOPS[i], p = PRICES[t];
      slider.style.setProperty("--p", `${(i / (STOPS.length - 1)) * 100}%`);
      input.setAttribute("aria-valuetext", `${label(t)} tickets`);
      ticks.forEach((li, j) => li.classList.toggle("on", j === i));
      set("standard", "[data-price]", money(p?.standard)); set("pro", "[data-price]", money(p?.pro));
      set("standard", "[data-extra]", extra(p?.standardExtra)); set("pro", "[data-extra]", extra(p?.proExtra));
      set("standard", "[data-tickets]", `${label(t)} tickets per month`); set("pro", "[data-tickets]", `${label(t)} tickets per month`);
    };
    input.addEventListener("input", update);
    ticks.forEach((li) => li.addEventListener("click", () => { input.value = li.dataset.i || "0"; update(); }));
  }
</script>
