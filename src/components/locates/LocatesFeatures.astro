---
/* How Clad Locates works: the product story's layout without the scroll pin. Pick a step on the left and its UI plays
   in the gray panel on the right. Title and step copy are Jason's (2026-10-14). The Submit and Track panels follow
   Jocelyn's product screenshots (2026-10-13), restyled in the site's card system; their names and IDs (LOCATE-1,
   DRAFT-19, 4861 Delray, FiberLight, PG&E, Pawnee County, Private Water Co.) come from those screenshots. The Manage
   panel, the project names and every date are Claude's sample data. */
const steps = [
  { id: "submit", title: "Submit", desc: "Use AI and bulk upload tools to quickly create high quality tickets" },
  { id: "track", title: "Track", desc: "Access a dashboard of your 811 tickets that is updated automatically, with no setup required" },
  { id: "manage", title: "Manage", desc: "Submit no response tickets, renew expiring 811 tickets, and organize tickets by project" },
];
const narrative = "From the intersection of Delray Road and Seibles Road, locate 476 feet southeast along Delray Road. Locate 20 feet on either side of the path.";

// Track: ring = response progress (full = all clear, part = waiting on some utilities)
const tracking = [  // ring, name (null = skeleton), status, scheduled for
  ["ok", "LOCATE-1", "Submitted", "Jul 23"],
  ["", "LOCATE-8", null, null],
  ["part", "LOCATE-13", null, null],
  ["", null, null, null],
  ["ok", null, null, null],
  ["", null, null, null],
] as const;
const responses = [["FiberLight", "ok"], ["PG&E", "ok"], ["Pawnee County", "warn"], ["Private Water Co.", "warn"]];

// Manage: one project open; an expiring ticket renews and a no-response ticket goes out
const manage = [  // id, address (null = skeleton), status before, status after, expires before, after
  ["LOCATE-1", "4861 Delray", ["Cleared", "ok"], null, "Oct 22", null],
  ["LOCATE-8", null, ["Expires Fri", "warn"], ["Renewed", "ok"], "Oct 16", "Oct 30"],
  ["LOCATE-13", null, ["No response", "warn"], ["No response ticket sent", "info"], "Oct 24", null],
] as const;

const icon = {
  pin: '<svg viewBox="0 0 16 16"><path d="M8 14.5s4.8-4.4 4.8-8.3a4.8 4.8 0 0 0-9.6 0c0 3.9 4.8 8.3 4.8 8.3z"/><circle cx="8" cy="6.2" r="1.7"/></svg>',
  doc: '<svg viewBox="0 0 16 16"><path d="M4 1.5h5l3 3v10H4z"/><path d="M9 1.5v3h3M6 8.5h4M6 11h4"/></svg>',
  info: '<svg viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.3"/><path d="M8 7.3v4M8 5v.1"/></svg>',
  folder: '<svg viewBox="0 0 16 16"><path d="M1.8 4.2c0-.7.5-1.2 1.2-1.2h3l1.5 1.6H13c.7 0 1.2.5 1.2 1.2v6.5c0 .7-.5 1.2-1.2 1.2H3c-.7 0-1.2-.5-1.2-1.2z"/></svg>',
  caret: '<svg class="caret" viewBox="0 0 16 16"><path d="M4.5 6.5 8 10l3.5-3.5"/></svg>',
};
---
<section class="container feats-sec" id="how-it-works">
  <div class="grid">
    <div class="head">
      <h2 class="t-title">How Clad Locates works</h2>
      <ul class="feats" role="tablist" aria-label="How Clad Locates works">
        {steps.map((f, i) => (
          <li class:list={{ "is-active": i === 0 }}>
            <button type="button" role="tab" id={`lf-tab-${f.id}`} aria-controls={`lf-${f.id}`} aria-selected={i === 0 ? "true" : "false"} data-view={f.id}>
              <b>{f.title}</b><span>{f.desc}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <div class="stage">
      <!-- Submit: drafted locates in one list; the selected one's narrative writes itself and its area draws on the map -->
      <div class="view is-active" id="lf-submit" role="tabpanel" aria-labelledby="lf-tab-submit">
        <div class="card blk">
          <div class="list">
            <div class="phd"><div><b>Locates</b><span>3 locates found</span></div><span class="btn2 submit">Submit all</span></div>
            <div class="cards">
              <div class="dc" style="--j:0"><em class="chip">Apply to all</em><div class="ln"><Fragment set:html={icon.info} /><span class="skl"><i style="--sw:85%"></i><i style="--sw:45%"></i></span></div></div>
              <div class="dc sel" style="--j:1">
                <em class="chip">DRAFT-19</em>
                <div class="ln"><Fragment set:html={icon.pin} /><span>4861 Delray</span></div>
                <div class="ln"><Fragment set:html={icon.doc} /><span class="clamp words">{narrative.split(" ").map((w, i) => <span style={`--w:${i}`}>{w} </span>)}</span></div>
              </div>
              <div class="dc" style="--j:2"><em class="chip">DRAFT-15</em><div class="ln"><Fragment set:html={icon.pin} /><span class="skl"><i style="--sw:50%"></i></span></div><div class="ln"><Fragment set:html={icon.doc} /><span class="skl"><i style="--sw:90%"></i><i style="--sw:35%"></i></span></div></div>
              <div class="dc" style="--j:3"><em class="chip">DRAFT-8</em><div class="ln"><Fragment set:html={icon.pin} /><span class="skl"><i style="--sw:50%"></i></span></div><div class="ln"><Fragment set:html={icon.doc} /><span class="skl"><i style="--sw:90%"></i><i style="--sw:35%"></i></span></div></div>
            </div>
          </div>
          <div class="detail">
            <div class="phd"><div><b>Locate details</b><span>DRAFT-19</span></div><em class="chip">1 of 3</em></div>
            <div class="edit">
              <b>Edit locate</b><span>DRAFT-19</span>
              <svg class="map" viewBox="0 0 400 240" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                <rect width="400" height="240" fill="#ecebe6" />
                <g fill="#e2e1db">
                  <rect x="120" y="22" width="30" height="40" rx="3" transform="rotate(25 135 42)" />
                  <rect x="330" y="150" width="54" height="34" rx="3" transform="rotate(8 357 167)" />
                  <rect x="250" y="196" width="28" height="40" rx="3" transform="rotate(20 264 216)" />
                  <rect x="320" y="20" width="22" height="26" rx="3" transform="rotate(-18 331 33)" />
                </g>
                <line x1="-10" y1="14" x2="410" y2="256" stroke="#fff" stroke-width="16" />
                <line x1="138" y1="94" x2="186" y2="-10" stroke="#fff" stroke-width="12" />
                <path class="buffer" d="M150 101 L296 185" pathLength="1" />
                <path class="center" d="M150 101 L296 185" pathLength="1" />
                <text class="rd" transform="translate(196 132) rotate(30)">SEIBLES RD</text>
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Track: utility responses tick in under a ticket, no inbox needed -->
      <div class="view" id="lf-track" role="tabpanel" aria-labelledby="lf-tab-track" hidden>
        <div class="card trk">
          <div class="chd"><b>Locates</b><span class="btn2 ghost">Filter</span><span class="btn2 ghost push">Renew tickets</span></div>
          <div class="th"><span></span><span>Name</span><span>Status</span><span>Scheduled for</span></div>
          <div class="rows">
            {tracking.map(([ring, name, st, when], j) => (
              <div class="tr" style={`--j:${j}`}>
                <i class={`ring ${ring}`} aria-hidden="true"></i>
                {name ? <b class="id">{name}</b> : <i class="sk" style="--sw:55%"></i>}
                {st ? <span>{st}</span> : <i class="sk" style="--sw:60%"></i>}
                {when ? <span>{when}</span> : <i class="sk" style="--sw:60%"></i>}
              </div>
            ))}
            <ul class="pop resp">
              {responses.map(([who, s], k) => <li style={`--k:${k}`}><i class={`ri ${s}`} aria-hidden="true"></i>{who}</li>)}
            </ul>
          </div>
        </div>
      </div>

      <!-- Manage: tickets grouped by project; an expiring ticket renews and a no-response ticket goes out -->
      <div class="view" id="lf-manage" role="tabpanel" aria-labelledby="lf-tab-manage" hidden>
        <div class="card mng">
          <div class="chd"><b>Locates</b><span class="btn2 ghost">Filter</span><span class="btn2 push renew">Renew tickets</span></div>
          <div class="th"><span>Locate ID</span><span>Address</span><span>Status</span><span class="r">Expires</span></div>
          <div class="proj" style="--j:0"><Fragment set:html={icon.caret} /><Fragment set:html={icon.folder} /><b>Suffolk, VA · Zone 1.4</b><span>3 tickets</span></div>
          {manage.map(([id, ad, a, b, ea, eb], j) => (
            <div class={`tr m${j}`} style={`--j:${j + 1}`}>
              <em class="chip">{id}</em>
              {ad ? <span>{ad}</span> : <i class="sk" style="--sw:70%"></i>}
              <span class="st"><em class={`spill ${a[1]} a`}>{a[0]}</em>{b && <em class={`spill ${b[1]} b`}>{b[0]}</em>}</span>
              <span class="st ex"><span class="a">{ea}</span>{eb && <span class="b">{eb}</span>}</span>
            </div>
          ))}
          <div class="proj closed" style="--j:4"><Fragment set:html={icon.caret} /><Fragment set:html={icon.folder} /><b>Suffolk, VA · Zone 1.5</b><span>6 tickets</span></div>
          <div class="proj closed" style="--j:5"><Fragment set:html={icon.caret} /><Fragment set:html={icon.folder} /><b>Chesapeake, VA · Zone 2.1</b><span>4 tickets</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .feats-sec { padding: 120px 0; border-top: 1px solid #dddcd6; }
  .grid { display: grid; grid-template-columns: minmax(0, .74fr) minmax(0, 1.26fr); gap: clamp(32px, 4.5vw, 64px); align-items: center; }
  /* title stacked over the steps, left of the stage, like the homepage story scenes */
  .head { display: flex; flex-direction: column; gap: 32px; }

  /* step list: same treatment as the homepage story (30% until active, product color rule) */
  .feats { display: flex; flex-direction: column; margin: 0; padding: 0; list-style: none; }
  .feats li { opacity: .3; transition: opacity .35s ease; }
  .feats li.is-active, .feats li:hover { opacity: 1; }
  .feats button { display: flex; flex-direction: column; gap: 4px; width: 100%; padding: 16px 0 16px 20px; text-align: left; border-left: 2px solid rgb(37 34 12 / .18); transition: border-color .35s ease; }
  .feats li.is-active button { border-left-color: var(--color-stoplight); }
  .feats b { font-size: 17px; font-weight: 600; letter-spacing: -0.2px; line-height: 1.3; }
  .feats span { font-size: 14px; line-height: 1.45; letter-spacing: -0.1px; max-width: 40ch; }

  /* stage: the homepage story panel (16:10 plus 25px top and bottom), UIs sized in em off its width */
  .stage { position: relative; aspect-ratio: 16 / 10; box-sizing: content-box; padding-block: 25px; border-radius: 20px;
    background: #f4f4f2; box-shadow: inset 0 0 0 1px #e8e8e4;
    container-type: inline-size; font-size: clamp(7px, 1.62cqw, 13px); color: #1f1f1f; letter-spacing: 0; line-height: 1.3; }
  .view { position: absolute; inset: 0; display: grid; place-items: center; }
  .view[hidden] { display: none; }
  .view.is-active { animation: view-in .45s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes view-in { from { opacity: 0; transform: translateY(1.2em) scale(.98); } }

  /* shared card chrome, pills, chips, skeletons and icons (the homepage story's) */
  .card { background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 0 0 1px rgb(0 0 0 / .12), 0 0 2px rgb(0 0 0 / .08), 0 2px 6px rgb(0 0 0 / .1), 0 18px 40px -24px rgb(37 34 12 / .35); }
  .chd { display: flex; align-items: center; gap: .8em; padding: 1em 1.3em; border-bottom: 1px solid #efefed; }
  .chd b { font-size: 1.2em; font-weight: 600; letter-spacing: -.01em; }
  .btn2 { display: inline-flex; align-items: center; height: 2.5em; padding: 0 1.1em; border-radius: .55em; background: #111; color: #fff; white-space: nowrap; }
  .btn2.ghost { background: #fff; color: #1f1f1f; border: 1px solid #e3e3e0; }
  .btn2.push { margin-left: auto; }
  .chip { display: inline-flex; align-items: center; justify-self: start; align-self: start; height: 2em; padding: 0 .8em; border: 1px solid #e3e3e0; border-radius: 999px; font-style: normal; font-size: .9em; font-weight: 500; white-space: nowrap; background: #fff; }
  .tr .chip { align-self: center; }
  .spill { display: inline-flex; align-items: center; gap: .45em; border-radius: 999px; padding: .22em .75em .22em .6em; font-size: .88em; font-style: normal; border: 1px solid var(--c); color: var(--c); background: #fff; white-space: nowrap; }
  .spill::before { content: ""; width: .5em; height: .5em; border-radius: 50%; background: var(--c); }
  .spill.ok { --c: #2f9e5b; } .spill.warn { --c: #d9822b; } .spill.info { --c: #4750ff; }
  .sk { display: block; height: .7em; width: var(--sw, 70%); border-radius: 99px; background: #efefec; }
  .th, .tr { display: grid; align-items: center; gap: .9em; padding: .85em 1.3em; }
  .th { padding-block: .7em; color: #8a8a86; font-size: .85em; background: #fafaf8; border-bottom: 1px solid #efefed; }
  .th .r { text-align: right; }
  .tr { border-bottom: 1px solid #f1f1ef; }
  .rows { position: relative; }
  .pop { position: absolute; z-index: 2; margin: 0; background: #fff; border-radius: .8em; box-shadow: 0 0 0 1px rgb(0 0 0 / .08), 0 10px 28px -8px rgb(37 34 12 / .3); opacity: 0; transform-origin: top left; }
  /* icons arrive via set:html, so they need :global to pick these up */
  .card :global(svg:not(.map)) { flex: none; width: 1.15em; height: 1.15em; color: #6f6f6b; fill: none; stroke: currentColor; stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }

  /* Submit: drafted locates on the left, the selected one's map on the right */
  .blk { width: 92%; height: 86%; display: grid; grid-template-columns: 1fr 1.2fr; }
  .phd { display: flex; align-items: center; justify-content: space-between; gap: .8em; padding: 1em 1.2em; border-bottom: 1px solid #efefed; }
  .phd > div { display: flex; flex-direction: column; gap: .15em; }
  .phd b { font-size: 1.2em; font-weight: 600; } .phd > div span { color: #8a8a86; font-size: .9em; }
  .list { display: flex; flex-direction: column; min-height: 0; border-right: 1px solid #efefed; }
  .cards { display: flex; flex-direction: column; gap: .6em; padding: .8em; background: #fafaf8; flex: 1; overflow: hidden; }
  .dc { display: flex; flex-direction: column; gap: .5em; padding: .8em .9em; background: #fff; border-radius: .7em; box-shadow: 0 0 0 1px #e8e8e4; }
  .ln { display: flex; align-items: flex-start; gap: .55em; font-size: .92em; min-width: 0; }
  .ln > span { min-width: 0; }
  .clamp { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .words span { opacity: 0; }
  .skl { flex: 1; display: flex; flex-direction: column; gap: .45em; padding-top: .25em; }
  .skl i { display: block; height: .6em; width: var(--sw); border-radius: 99px; background: #efefec; }
  .detail { display: flex; flex-direction: column; min-width: 0; }
  .edit { flex: 1; display: flex; flex-direction: column; gap: .15em; margin: .9em; padding: 1em; border-radius: .7em; box-shadow: 0 0 0 1px #e8e8e4; min-height: 0; }
  .edit b { font-size: 1.15em; font-weight: 600; } .edit > span { color: #8a8a86; font-size: .9em; margin-bottom: .7em; }
  .map { flex: 1; min-height: 0; width: 100%; border-radius: .4em; }
  .map .rd { font-family: var(--font-mono); font-size: 9px; letter-spacing: .14em; fill: #9a9992; }
  .map .buffer { fill: none; stroke: rgb(255 204 0 / .5); stroke-width: 30; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .map .center { fill: none; stroke: #25220c; stroke-width: 1.5; stroke-dasharray: 1; stroke-dashoffset: 1; }

  /* Track: ring per ticket, utility responses in a popover under LOCATE-13 */
  .trk { width: 84%; }
  .trk .th, .trk .tr { grid-template-columns: 1.5em 1.5fr 1fr 1fr; }
  .trk .tr { padding-block: 1em; }
  .trk .tr:last-of-type { border-bottom: 0; }
  .trk .rows { min-height: 21em; }
  .trk .id { font-weight: 500; letter-spacing: .01em; }
  .ring { position: relative; width: 1.4em; height: 1.4em; border-radius: 50%; border: 1.5px solid #d6d6d2; }
  .ring::after { content: ""; position: absolute; inset: 2.5px; border-radius: 50%; }
  .ring.ok { border-color: #2f9e5b; } .ring.ok::after { background: #2f9e5b; }
  .ring.part { border-color: #d9822b; } .ring.part::after { background: conic-gradient(#d9822b 0 50%, transparent 0); }
  .resp { left: 2.6em; top: 10.3em; display: flex; flex-direction: column; gap: .75em; padding: 1em 1.4em 1em 1.1em; list-style: none; }
  .resp li { display: flex; align-items: center; gap: .8em; white-space: nowrap; }
  .ri { position: relative; flex: none; width: 1.4em; height: 1.4em; border-radius: 50%; background: var(--c); }
  .ri.ok { --c: #2f9e5b; } .ri.warn { --c: #d9822b; }
  .ri.ok::after { content: ""; position: absolute; left: .5em; top: .28em; width: .3em; height: .6em; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); }
  .ri.warn::after { content: "!"; position: absolute; inset: 0; display: grid; place-items: center; color: #fff; font-weight: 800; font-size: .85em; }

  /* Manage: tickets grouped by project folder, statuses flip in place */
  .mng { width: 88%; }
  .mng .th, .mng .tr { grid-template-columns: 6.4em 1fr 13em 4.4em; padding-left: 3.4em; }
  .proj { display: flex; align-items: center; gap: .55em; padding: .8em 1.3em; border-bottom: 1px solid #f1f1ef; background: #fcfcfa; }
  .proj b { font-weight: 600; } .proj span { color: #8a8a86; font-size: .9em; }
  .proj.closed :global(.caret) { transform: rotate(-90deg); }
  .proj.closed:last-child { border-bottom: 0; }
  .st { position: relative; height: 1.9em; }
  .st > * { position: absolute; left: 0; top: 50%; translate: 0 -50%; }
  .st .b { opacity: 0; }
  .st.ex > * { left: auto; right: 0; color: #6f6f6b; }

  /* motion: each UI plays once when its step is picked */
  .is-active .buffer, .is-active .center { animation: draw .9s 1.1s cubic-bezier(.65,0,.35,1) forwards; }
  .is-active .words span { animation: fade .2s forwards; animation-delay: calc(.9s + var(--w) * 30ms); }
  .is-active .tr, .is-active .dc, .is-active .proj { animation: row-in .4s backwards; animation-delay: calc(.15s + var(--j) * .08s); }
  .is-active .dc.sel { animation: row-in .4s backwards .23s, select .3s .7s forwards; }
  .is-active .submit { animation: press .3s 2.3s; }
  .is-active .ring.part::after { animation: fade .4s .7s backwards; }
  .is-active .resp { animation: pop .3s .9s forwards; }
  .is-active .resp li { animation: row-in .3s backwards; animation-delay: calc(1.15s + var(--k) * .3s); }
  .is-active .ri { animation: pop .25s backwards; animation-delay: calc(1.2s + var(--k) * .3s); }
  .is-active .renew { animation: press .3s .8s; }
  .is-active .m1 .st .a { animation: fade .2s 1.05s reverse forwards; }
  .is-active .m1 .st .b { animation: fade .3s 1.1s forwards; }
  .is-active .m2 .st:not(.ex) .a { animation: fade .2s 1.75s reverse forwards; }
  .is-active .m2 .st:not(.ex) .b { animation: fade .3s 1.8s forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
  @keyframes pop { from { opacity: 0; transform: scale(.92); } to { opacity: 1; transform: none; } }
  @keyframes row-in { from { opacity: 0; transform: translateY(.6em); } }
  @keyframes press { 50% { transform: scale(.94); } }
  @keyframes select { to { box-shadow: 0 0 0 1.5px #111; } }
  /* reduced motion: jump straight to each UI's finished state */
  @media (prefers-reduced-motion: reduce) {
    .view.is-active, .view.is-active * { animation-duration: 1ms !important; animation-delay: 0s !important; }
  }

  @media (max-width: 900px) {
    .feats-sec { padding: 72px 0; }
    .grid { grid-template-columns: 1fr; gap: 24px; }
    .head { gap: 20px; }
    .feats button { padding: 10px 0 10px 14px; }
    .feats li:not(.is-active) span { display: none; }
    .stage { border-radius: 14px; }
    .trk, .blk, .mng { width: 95%; }
  }
</style>

<script>
  const sec = document.querySelector<HTMLElement>(".feats-sec");
  if (sec) {
    const tabs = Array.from(sec.querySelectorAll<HTMLButtonElement>(".feats button"));
    tabs.forEach((tab) => tab.addEventListener("click", () => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.closest("li")?.classList.toggle("is-active", on);
        t.setAttribute("aria-selected", on ? "true" : "false");
        const view = document.getElementById(`lf-${t.dataset.view}`);
        if (view) { view.hidden = !on; view.classList.toggle("is-active", on); }
      });
    }));
    // play the first UI when the section scrolls into view, not on page load
    const first = sec.querySelector<HTMLElement>(".view.is-active");
    if (first && "IntersectionObserver" in window) {
      first.classList.remove("is-active");
      const io = new IntersectionObserver((es) => {
        if (es.some((e) => e.isIntersecting)) { sec.querySelector(".view:not([hidden])")?.classList.add("is-active"); io.disconnect(); }
      }, { threshold: 0.5 });
      io.observe(sec.querySelector(".stage")!);
    }
  }
</script>
