---
/* Locates product page hero. Copy is Jason's (2026-10-14). */
import EmailForm from "../EmailForm.astro";
---
<section class="container hero">
  <h1>Submit, track, and update your <span class="hl hl--stoplight">811 tickets</span></h1>
  <p class="tagline">The AI-powered 811 ticket management system for contractors</p>
  <EmailForm id="hero-email" button="Try now" />
</section>

<style>
  .hero { padding: 72px 0 120px; }
  h1 { font-size: var(--text-display); line-height: 1.02; letter-spacing: -1.5px; max-width: 900px; }
  h1 .hl { margin: 0 -2px; padding: 0 6px; font-weight: inherit; }
  .tagline { margin: 27px 0 44px; font-size: var(--text-body); line-height: 1.3; max-width: 36ch; }
  @media (max-width: 900px) { .hero { padding: 40px 0 72px; } .tagline { margin: 18px 0 28px; font-size: 17px; } }
</style>
