---
/* Who it's for: pick an audience, see what Clad does for them, plus one proof point.
   Contractors get a case study, Asset Owners a quote. Kept black and white and airy on purpose.
   Contractor copy is from the Figma file. Asset Owner features are a DRAFT pending Jason, and the quote and
   case study are placeholders until real ones are approved. */
type Feature = { icon: string; title: string; desc: string };
type Proof =
  | { kind: "case"; eyebrow: string; title: string; link: string; href: string }
  | { kind: "quote"; text: string; name: string; role: string };
const audiences: { id: string; label: string; sub: string; features: Feature[]; proof: Proof }[] = [
  {
    id: "contractors", label: "Contractors",
    sub: 'Supporting companies from <span class="hl hl--tar">$1 to +$100M</span> of revenue.',
    features: [
      { icon: "ads_click", title: "Track it all", desc: "Manage all of your work, from half-day drops to multi-month builds." },
      { icon: "assignment", title: "Stop over-billing", desc: "Tie subcontractor bills to production, eliminating the risk of over-paying your vendors." },
      { icon: "receipt_long", title: "Get paid faster", desc: "Reduce DSO by generating invoices and as-builts in minutes." },
    ],
    proof: { kind: "case", eyebrow: "Case study", title: "Lorem ipsum company dolor sit amet consecteur", link: "Read the case study", href: "#case-contractors" },
  },
  {
    id: "asset-owners", label: "Asset Owners",
    sub: "For utilities, municipalities, and network owners managing outside crews.",
    features: [
      { icon: "analytics", title: "See progress as it happens", desc: "Contractor production and as-builts land in your dashboard the day the work is done." },
      { icon: "assignment", title: "Verify before you pay", desc: "Every contractor invoice ties back to quantities approved in the field." },
      { icon: "ads_click", title: "One record across every crew", desc: "Standard reporting across contractors, vendors, and regions." },
    ],
    proof: { kind: "quote", text: "[Asset owner quote, pending approval]", name: "[Name, Title]", role: "[Utility or municipality]" },
  },
];
---
<section class="container aud" id="use-cases">
  <span class="pill label">Who it’s for</span>
  <div class="tabs" role="tablist" aria-label="Audience">
    {audiences.map((a, i) => (
      <button role="tab" id={`tab-${a.id}`} aria-selected={i === 0 ? "true" : "false"} aria-controls={`panel-${a.id}`} class:list={["tab", { "is-active": i === 0 }]} data-tab={a.id}>{a.label}</button>
    ))}
    <span class="indicator" aria-hidden="true"></span>
  </div>
  {audiences.map((a, i) => (
    <div class="panel" role="tabpanel" id={`panel-${a.id}`} aria-labelledby={`tab-${a.id}`} hidden={i !== 0}>
      <p class="sub" set:html={a.sub} />
      <div class="grid">
        <ul class="features">
          {a.features.map((f) => (
            <li>
              <img class="icon" src={`/assets/icons/${f.icon}.svg`} alt="" width="26" height="26" />
              <div class="text"><h3>{f.title}</h3><p>{f.desc}</p></div>
            </li>
          ))}
        </ul>
        {a.proof.kind === "case" ? (
          <a class="proof case" href={a.proof.href}>
            <span class="mono eyebrow">{a.proof.eyebrow}</span>
            <h3>{a.proof.title}</h3>
            <span class="more">{a.proof.link} <span aria-hidden="true">→</span></span>
          </a>
        ) : (
          <figure class="proof quote">
            <span class="mark" aria-hidden="true">“</span>
            <blockquote>{a.proof.text}</blockquote>
            <figcaption><b>{a.proof.name}</b><span class="mono">{a.proof.role}</span></figcaption>
          </figure>
        )}
      </div>
    </div>
  ))}
</section>

<style>
  .aud { margin-top: 98px; }
  .label { background: var(--color-paper); }
  .tabs { position: relative; display: flex; gap: 36px; margin-top: 14px; padding-bottom: 12px; border-bottom: var(--hairline) solid var(--color-tar); }
  .tab { font-family: var(--font-display); font-size: var(--text-h2); line-height: 1.2; letter-spacing: -0.5px; font-weight: 600; opacity: 0.25; transition: opacity .15s; }
  .tab.is-active, .tab:hover { opacity: 1; }
  .indicator { position: absolute; left: 0; bottom: -1.5px; width: 230px; height: 2px; background: var(--color-tar); transition: transform .3s cubic-bezier(.2,.7,.2,1), width .3s cubic-bezier(.2,.7,.2,1); }
  .sub { margin-top: 32px; font-size: var(--text-body); line-height: 1.3; letter-spacing: -0.2px; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); margin-top: 40px; align-items: start; }

  /* features: open rows on hairlines, black line icons, lots of air */
  .features { margin: 0; padding: 0; list-style: none; border-top: var(--hairline) solid var(--color-tar); }
  .features li { display: grid; grid-template-columns: 26px 1fr; gap: 20px; padding: 26px 0; border-bottom: var(--hairline) solid var(--color-tar); }
  .icon { width: 26px; height: 26px; margin-top: 2px; filter: brightness(0); } /* some exports are white (made for colored tiles); force black */
  .text h3 { font-size: var(--text-body); line-height: 1.3; font-weight: 600; letter-spacing: -0.2px; }
  .text p { margin-top: 6px; font-size: 15px; line-height: 1.5; letter-spacing: -0.1px; max-width: 46ch; opacity: .75; }

  /* one proof point per audience, in the same light frame */
  .proof { display: flex; flex-direction: column; min-height: 100%; padding: 40px 36px 34px; border: var(--hairline) solid var(--color-tar); border-radius: var(--radius-md); background: var(--color-paper); color: var(--color-tar); margin: 0; }
  .case { justify-content: space-between; gap: 48px; text-decoration: none; transition: background-color .2s; }
  .case:hover { background: var(--color-paper-warm); }
  .case .eyebrow { opacity: .6; }
  .case h3 { font-size: var(--text-card); line-height: 1.25; font-weight: 600; letter-spacing: -0.4px; max-width: 18ch; }
  .case .more { font-family: var(--font-mono); font-size: 13px; letter-spacing: .08em; text-transform: uppercase; }
  .case:hover .more { text-decoration: underline; text-underline-offset: 4px; }
  .quote .mark { font-family: var(--font-display); font-size: 72px; line-height: .6; height: 34px; opacity: .2; }
  .quote blockquote { margin: 16px 0 0; font-size: 26px; line-height: 1.3; letter-spacing: -0.4px; font-weight: 500; }
  .quote figcaption { display: flex; flex-direction: column; gap: 4px; margin-top: auto; padding-top: 40px; }
  .quote figcaption b { font-size: 16px; font-weight: 600; }
  .quote figcaption .mono { font-size: 12px; opacity: .6; }
  .panel[hidden] { display: none; }

  @media (max-width: 1000px) { .grid { grid-template-columns: 1fr; } .proof { padding: 32px 24px 28px; } .case h3 { font-size: 24px; } .quote blockquote { font-size: 22px; } }
  @media (max-width: 900px) { .aud { margin-top: 64px; } .tabs { gap: 20px; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>(".aud");
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".tab"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>(".panel"));
    const indicator = root.querySelector<HTMLElement>(".indicator");
    const place = (tab: HTMLButtonElement) => {
      if (!indicator) return;
      indicator.style.width = tab.offsetWidth + "px";
      indicator.style.transform = `translateX(${tab.offsetLeft}px)`;
    };
    tabs.forEach((tab) =>
      tab.addEventListener("click", () => {
        tabs.forEach((t) => { const on = t === tab; t.classList.toggle("is-active", on); t.setAttribute("aria-selected", on ? "true" : "false"); });
        panels.forEach((p) => { p.hidden = p.id !== `panel-${tab.dataset.tab}`; });
        place(tab);
      })
    );
    const active = tabs.find((t) => t.classList.contains("is-active"));
    if (active) place(active);
    window.addEventListener("resize", () => { const a = tabs.find((t) => t.classList.contains("is-active")); if (a) place(a); });
  }
</script>
