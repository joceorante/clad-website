---
/* Use cases and case studies in one section: pick an audience, see what Clad does for them and a story from it.
   Contractor copy is from the Figma file; Asset Owner copy is a DRAFT placeholder pending Jason. */
const audiences = [
  {
    id: "contractors", label: "Contractors",
    sub: 'Supporting companies from <span class="hl hl--tar">$1 to +$100M</span> of revenue.',
    features: [
      { icon: "ads_click", color: "var(--color-orange)", title: "Track it all", desc: "Manage all of your work, from half-day drops to multi-month builds." },
      { icon: "assignment", color: "var(--color-stoplight)", title: "Stop over-billing", desc: "Tie subcontractor bills to production, eliminating the risk of over-paying your vendors." },
      { icon: "receipt_long", color: "var(--color-lilac)", title: "Get paid faster", desc: "Reduce DSO by generating invoices and as-builts in minutes." },
    ],
    study: { eyebrow: "Case study", title: "Lorem ipsum company dolor sit amet consecteur", link: "Lorem ipsum dolor sit amet", href: "#case-contractors" },
  },
  {
    id: "asset-owners", label: "Asset Owners",
    sub: "For utilities, municipalities, and network owners managing outside crews.",
    features: [
      { icon: "analytics", color: "var(--color-cobalt)", title: "See progress as it happens", desc: "Contractor production and as-builts land in your dashboard the day the work is done." },
      { icon: "assignment", color: "var(--color-stoplight)", title: "Verify before you pay", desc: "Every contractor invoice ties back to quantities approved in the field." },
      { icon: "ads_click", color: "var(--color-orange)", title: "One record across every crew", desc: "Standard reporting across contractors, vendors, and regions." },
    ],
    study: { eyebrow: "Case study", title: "Lorem ipsum company dolor sit amet consecteur", link: "Lorem ipsum dolor sit amet", href: "#case-asset-owners" },
  },
];
---
<section class="container aud" id="use-cases">
  <span class="pill label">Who it’s for</span>
  <div class="tabs" role="tablist" aria-label="Audience">
    {audiences.map((a, i) => (
      <button role="tab" id={`tab-${a.id}`} aria-selected={i === 0 ? "true" : "false"} aria-controls={`panel-${a.id}`} class:list={["tab", { "is-active": i === 0 }]} data-tab={a.id}>{a.label}</button>
    ))}
    <span class="indicator" aria-hidden="true"></span>
  </div>
  {audiences.map((a, i) => (
    <div class="panel" role="tabpanel" id={`panel-${a.id}`} aria-labelledby={`tab-${a.id}`} hidden={i !== 0}>
      <p class="sub" set:html={a.sub} />
      <div class="grid">
        <ul class="features">
          {a.features.map((f) => (
            <li class="card">
              <div class="icon" style={`background:${f.color}`}><img src={`/assets/icons/${f.icon}.svg`} alt="" width="34" height="34" /></div>
              <div class="text"><h3>{f.title}</h3><p>{f.desc}</p></div>
            </li>
          ))}
        </ul>
        <div class="study">
          <a class="study-card" href={a.study.href}>
            <span class="mono eyebrow">{a.study.eyebrow}</span>
            <h3>{a.study.title}</h3>
            <span class="more">{a.study.link} <span aria-hidden="true">→</span></span>
          </a>
          <a class="btn" href="#cases-all">See all case studies <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  ))}
</section>

<style>
  .aud { margin-top: 98px; }
  .label { background: var(--color-paper-dim); }
  .tabs { position: relative; display: flex; gap: 36px; margin-top: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--color-rule-light); }
  .tab { font-family: var(--font-display); font-size: var(--text-h2); line-height: 1.2; letter-spacing: -0.5px; font-weight: 600; opacity: 0.3; transition: opacity .15s; }
  .tab.is-active, .tab:hover { opacity: 1; }
  .indicator { position: absolute; left: 0; bottom: -1px; width: 230px; height: 3px; background: var(--color-tar); transition: transform .3s cubic-bezier(.2,.7,.2,1), width .3s cubic-bezier(.2,.7,.2,1); }
  .sub { margin-top: 36px; font-size: var(--text-body); line-height: 1.3; letter-spacing: -0.2px; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) 508px; gap: 24px; margin-top: 36px; align-items: stretch; }
  .features { display: flex; flex-direction: column; gap: 16px; margin: 0; padding: 0; list-style: none; }
  .card { display: flex; gap: 20px; align-items: flex-start; padding: 20px; border: var(--hairline) solid var(--color-tar); border-radius: var(--radius-md); flex: 1; }
  .icon { flex: none; width: 56px; height: 56px; border-radius: var(--radius-sm); display: grid; place-items: center; }
  .icon img { width: 30px; height: 30px; }
  .text h3 { font-size: var(--text-body); line-height: 1.3; font-weight: 700; letter-spacing: -0.2px; }
  .text p { margin-top: 6px; font-size: var(--text-sm); line-height: 1.5; letter-spacing: -0.14px; max-width: 46ch; }
  .study { display: flex; flex-direction: column; gap: 16px; }
  .study-card { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; gap: 12px; min-height: 247px; padding: 48px 30px 37px; background: var(--color-tar); color: var(--color-paper); border-radius: var(--radius-md); text-decoration: none; }
  .study-card .eyebrow { color: var(--color-stoplight); }
  .study-card h3 { font-size: var(--text-card); line-height: 1.3; font-weight: 600; letter-spacing: -0.31px; }
  .study-card .more { font-size: var(--text-sm); line-height: 1.3; letter-spacing: -0.14px; }
  .study-card:hover .more { text-decoration: underline; text-underline-offset: 3px; }
  .study .btn { align-self: flex-start; }
  .panel[hidden] { display: none; }
  @media (max-width: 1000px) { .grid { grid-template-columns: 1fr; } .study-card { min-height: 200px; padding: 32px 24px 28px; } .study-card h3 { font-size: 24px; } }
  @media (max-width: 900px) { .aud { margin-top: 64px; } .tabs { gap: 20px; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>(".aud");
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".tab"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>(".panel"));
    const indicator = root.querySelector<HTMLElement>(".indicator");
    const place = (tab: HTMLButtonElement) => {
      if (!indicator) return;
      indicator.style.width = tab.offsetWidth + "px";
      indicator.style.transform = `translateX(${tab.offsetLeft}px)`;
    };
    tabs.forEach((tab) =>
      tab.addEventListener("click", () => {
        tabs.forEach((t) => { const on = t === tab; t.classList.toggle("is-active", on); t.setAttribute("aria-selected", on ? "true" : "false"); });
        panels.forEach((p) => { p.hidden = p.id !== `panel-${tab.dataset.tab}`; });
        place(tab);
      })
    );
    const active = tabs.find((t) => t.classList.contains("is-active"));
    if (active) place(active);
    window.addEventListener("resize", () => { const a = tabs.find((t) => t.classList.contains("is-active")); if (a) place(a); });
  }
</script>
