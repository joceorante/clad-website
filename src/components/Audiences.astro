---
/* Who it's for: pick an audience, see what Clad does for them, plus one proof point.
   Layout from Jocelyn's frame (2026-10-12): feature cards on the left, one dark proof card on the right.
   Contractors' features are from the Figma file and the case study headline is Jocelyn's. Asset Owner
   features are a DRAFT pending Jason, and their quote is a placeholder until a real one is approved. */
type Feature = { icon: string; title: string; desc: string };
type Proof =
  | { kind: "case"; logo: { src: string; alt: string; w: number; h: number }; title: string; link: string; href: string }
  | { kind: "quote"; text: string; name: string; role: string };
const audiences: { id: string; label: string; sub: string; features: Feature[]; proof: Proof }[] = [
  {
    id: "contractors", label: "Contractors",
    sub: 'Supporting companies from <span class="hl hl--tar">$1 to +$100M</span> of revenue.',
    features: [
      { icon: "ads_click", title: "Track it all", desc: "Manage all of your work, from half-day drops to multi-month builds." },
      { icon: "assignment", title: "Stop over-billing", desc: "Tie subcontractor bills to production, eliminating the risk of over-paying your vendors." },
      { icon: "receipt_long", title: "Get paid faster", desc: "Reduce DSO by generating invoices and as-builts in minutes" },
    ],
    proof: {
      kind: "case", logo: { src: "/assets/logos/intrepid.png", alt: "Intrepid", w: 125, h: 32 },
      title: "See how Intrepid accelerated their billing process", link: "Read more", href: "#case-intrepid",
    },
  },
  {
    id: "asset-owners", label: "Asset Owners",
    sub: "For utilities, municipalities, and network owners managing outside crews.",
    features: [
      { icon: "analytics", title: "See progress as it happens", desc: "Contractor production and as-builts land in your dashboard the day the work is done." },
      { icon: "assignment", title: "Verify before you pay", desc: "Every contractor invoice ties back to quantities approved in the field." },
      { icon: "ads_click", title: "One record across every crew", desc: "Standard reporting across contractors, vendors, and regions." },
    ],
    proof: { kind: "quote", text: "[Asset owner quote, pending approval]", name: "[Name, Title]", role: "[Utility or municipality]" },
  },
];
---
<section class="container aud" id="use-cases">
  <span class="t-label">Who it’s for</span>
  <div class="tabs" role="tablist" aria-label="Audience">
    {audiences.map((a, i) => (
      <button role="tab" id={`tab-${a.id}`} aria-selected={i === 0 ? "true" : "false"} aria-controls={`panel-${a.id}`} class:list={["tab", "t-title", { "is-active": i === 0 }]} data-tab={a.id}>{a.label}</button>
    ))}
    <span class="indicator" aria-hidden="true"></span>
  </div>
  {audiences.map((a, i) => (
    <div class="panel" role="tabpanel" id={`panel-${a.id}`} aria-labelledby={`tab-${a.id}`} hidden={i !== 0}>
      <p class="sub" set:html={a.sub} />
      <div class="grid">
        <ul class="features">
          {a.features.map((f) => (
            <li>
              <img class="icon" src={`/assets/icons/${f.icon}.svg`} alt="" width="28" height="28" />
              <div class="text"><h3>{f.title}</h3><p>{f.desc}</p></div>
            </li>
          ))}
        </ul>
        {a.proof.kind === "case" ? (
          <a class="proof case" href={a.proof.href}>
            <div class="foot">
              <img class="logo" src={a.proof.logo.src} alt={a.proof.logo.alt} width={a.proof.logo.w} height={a.proof.logo.h} />
              <h3>{a.proof.title}</h3>
              <span class="mono more">{a.proof.link} <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ) : (
          <figure class="proof quote">
            <span class="mark" aria-hidden="true">“</span>
            <div class="foot">
              <blockquote>{a.proof.text}</blockquote>
              <figcaption><b>{a.proof.name}</b><span class="mono">{a.proof.role}</span></figcaption>
            </div>
          </figure>
        )}
      </div>
    </div>
  ))}
</section>

<style>
  .aud { margin-top: 98px; }
  .aud > .t-label { display: flex; justify-content: center; }
  .tabs { position: relative; display: flex; justify-content: center; gap: 48px; margin-top: 28px; padding-bottom: 10px; border-bottom: 1px solid var(--color-tar); }
  .tab { opacity: 0.3; transition: opacity .15s; }  /* size and tracking come from .t-title, same as the story headlines */
  .tab.is-active, .tab:hover { opacity: 1; }
  .indicator { position: absolute; left: 0; bottom: -3px; width: 290px; height: 5px; background: var(--color-tar); transition: transform .3s cubic-bezier(.2,.7,.2,1), width .3s cubic-bezier(.2,.7,.2,1); }
  .sub { text-align: center; margin-top: 36px; font-size: var(--text-body); line-height: 1.3; letter-spacing: -0.2px; }
  .grid { display: grid; grid-template-columns: minmax(0, .72fr) minmax(0, 1fr); gap: clamp(32px, 4vw, 56px); margin-top: 40px; align-items: stretch; }

  /* features: open rows between light hairlines, icon beside the title */
  .features { display: flex; flex-direction: column; margin: 0; padding: 0; list-style: none; border-bottom: 1px solid #dddcd6; }
  .features li { flex: 1; display: grid; grid-template-columns: 28px 1fr; gap: 18px; align-content: center; padding: 28px 24px 28px 26px; border-top: 1px solid #dddcd6; }
  .icon { width: 28px; height: 28px; filter: brightness(0); } /* some exports are white (made for colored tiles); force black */
  .text h3 { font-size: var(--text-body); line-height: 1.3; font-weight: 600; letter-spacing: -0.2px; }
  .text p { margin-top: 8px; font-size: 16px; line-height: 1.5; letter-spacing: -0.1px; max-width: 44ch; color: #3b3a32; }

  /* one dark proof card per audience, as tall as the feature stack */
  .proof { display: flex; flex-direction: column; justify-content: flex-end; gap: 48px; margin: 0; padding: 44px 44px 40px;
    background: var(--color-tar); color: var(--color-paper); border-radius: 16px; text-decoration: none; }
  .case .logo { display: block; width: auto; height: 30px; margin-bottom: 22px; opacity: .85; filter: grayscale(1) brightness(1.4); }
  .case h3 { font-size: clamp(26px, 2.4vw, 34px); line-height: 1.2; font-weight: 600; letter-spacing: -0.6px; max-width: 18ch; }
  .case .more { display: inline-block; margin-top: 22px; font-size: 15px; letter-spacing: .06em; }
  .case:hover .more { text-decoration: underline; text-underline-offset: 4px; }
  .quote { justify-content: space-between; }
  .quote .mark { font-family: var(--font-display); font-size: 80px; line-height: .6; height: 36px; opacity: .35; }
  .quote blockquote { margin: 0; font-size: clamp(22px, 2vw, 28px); line-height: 1.3; letter-spacing: -0.4px; font-weight: 500; }
  .quote figcaption { display: flex; flex-direction: column; gap: 4px; margin-top: 28px; }
  .quote figcaption b { font-size: 16px; font-weight: 600; }
  .quote figcaption .mono { font-size: 12px; opacity: .6; }
  .panel[hidden] { display: none; }

  @media (max-width: 1000px) { .grid { grid-template-columns: 1fr; } .proof { padding: 32px 28px; min-height: 280px; } }
  @media (max-width: 900px) { .aud { margin-top: 64px; } .tabs { gap: 20px; } .tab { white-space: nowrap; } .features li { padding: 22px 8px; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>(".aud");
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>(".tab"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>(".panel"));
    const indicator = root.querySelector<HTMLElement>(".indicator");
    const place = (tab: HTMLButtonElement) => {
      if (!indicator) return;
      indicator.style.width = tab.offsetWidth + "px";
      indicator.style.transform = `translateX(${tab.offsetLeft}px)`;
    };
    tabs.forEach((tab) =>
      tab.addEventListener("click", () => {
        tabs.forEach((t) => { const on = t === tab; t.classList.toggle("is-active", on); t.setAttribute("aria-selected", on ? "true" : "false"); });
        panels.forEach((p) => { p.hidden = p.id !== `panel-${tab.dataset.tab}`; });
        place(tab);
      })
    );
    const active = tabs.find((t) => t.classList.contains("is-active"));
    if (active) place(active);
    window.addEventListener("resize", () => { const a = tabs.find((t) => t.classList.contains("is-active")); if (a) place(a); });
    document.fonts?.ready.then(() => { const a = tabs.find((t) => t.classList.contains("is-active")); if (a) place(a); });
  }
</script>
