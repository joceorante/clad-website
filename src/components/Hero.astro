---
const tabs = [["Project Management", "pm"], ["Billing", "billing"], ["Locates", "locates"]];
---
<section class="hero" id="products">
  <div class="container-wide">
    <h1>Scale your construction operations</h1>
    <p class="tagline">Project management and billing software for building infrastructure</p>
    <div class="tabs" role="tablist" aria-label="Product areas">
      {tabs.map(([label, id], i) => (
        <button role="tab" aria-selected={i === 0 ? "true" : "false"} class:list={["tab", { "is-active": i === 0 }]} data-tab={id}>{label}</button>
      ))}
    </div>
    <div class="shot">
      <img src="/assets/hero-screenshot.png" alt="A Clad field update: satellite map with redlined conduit and handholes, and a quantity form for UG-104-02" width="974" height="615" loading="eager" />
    </div>
  </div>
</section>

<style>
  .hero { padding-top: 71px; }
  h1 { font-size: var(--text-display); line-height: 1; letter-spacing: -1.5px; max-width: 844px; }
  .tagline { margin-top: 27px; font-size: var(--text-body); line-height: 1.3; letter-spacing: 0; }
  .tabs {
    display: flex; margin-top: 44px; border: 1px solid var(--color-tar);
    border-radius: var(--radius-md) var(--radius-md) 0 0; overflow: hidden;
  }
  .tab {
    flex: 1 0 0; height: 61px; font-size: var(--text-ui); text-align: center; letter-spacing: 0;
    background: var(--color-paper); border-right: var(--hairline) solid var(--color-tar);
    transition: background-color .15s;
  }
  .tab:last-child { border-right: 0; }
  .tab:hover { background: var(--color-paper-dim); }
  .tab.is-active { font-weight: 700; }
  .tab.is-active[data-tab="pm"] { background: var(--color-cobalt); color: var(--color-paper); }
  .tab.is-active[data-tab="billing"] { background: var(--color-orange); color: var(--color-paper); }
  .tab.is-active[data-tab="locates"] { background: var(--color-stoplight); color: var(--color-tar); }
  .shot {
    position: relative; z-index: 1; margin-bottom: -113px;
    background: var(--color-tar) url("/assets/grid.svg") -505px -573px / 2214px 2211px no-repeat;
    border: 1px solid var(--color-tar); padding: 52px 115px 53px;
  }
  .shot img { width: 100%; height: auto; border-radius: var(--radius-md); }
  @media (max-width: 900px) {
    .hero { padding-top: 40px; }
    .tagline { margin-top: 18px; font-size: 17px; }
    .tabs { margin-top: 28px; }
    .tab { height: 48px; font-size: 14px; }
    .shot { padding: 6%; margin-bottom: -60px; background-position: -300px -400px; background-size: 1400px 1398px; }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".hero .tab"));
  const hero = document.querySelector<HTMLElement>(".hero");
  tabs.forEach((tab) =>
    tab.addEventListener("click", () => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.classList.toggle("is-active", on);
        t.setAttribute("aria-selected", on ? "true" : "false");
      });
      if (hero) hero.dataset.tab = tab.dataset.tab;
    })
  );
</script>
