---
const addons = [
  { title: "Vendor Management", desc: "Onboard vendors and bid out work", color: "var(--color-lilac)", href: "#vendors" },
  { title: "Inventory Management", desc: "Track location of materials & fleet", color: "var(--color-stoplight)", href: "#inventory" },
];
---
<section class="container tools" id="tools">
  <h2 class="h2">Additional tools</h2>
  <div class="featured">
    <span class="pill badge">Featured Add-on</span>
    <div class="title">
      <img src="/assets/clad-logo-white.svg" alt="Clad" width="137" height="47" />
      <span class="word">Locates</span>
    </div>
    <p class="desc">AI to submit and track your 811 tickets.</p>
    <a class="btn btn--light cta" href="#locates">see locates <span aria-hidden="true">→</span></a>
    <div class="slab" aria-hidden="true"></div>
  </div>
  <ul class="addons"-group="110">
    {addons.map((a) => (
      <li class="addon">
        <div class="icon-wrap" aria-hidden="true"><div class="icon" style={`background:${a.color}`}></div></div>
        <div class="details">
          <h3>{a.title}</h3>
          <a href={a.href}>{a.desc} <span aria-hidden="true">→</span></a>
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  .tools { margin-top: 119px; }
  .featured {
    position: relative; margin-top: 27px; height: 397px; overflow: hidden;
    background: var(--color-tar); color: var(--color-paper); border-radius: var(--radius-md);
  }
  .badge { position: absolute; left: 44px; top: 54px; color: var(--color-stoplight); }
  .title { position: absolute; left: 44px; top: 105px; display: flex; align-items: center; gap: 10px; }
  .title img { width: 137px; height: 47px; }
  .word { font-size: 60.7px; line-height: 1.1; font-weight: 300; letter-spacing: -0.63px; }
  .desc { position: absolute; left: 44px; top: 181px; font-size: var(--text-body); line-height: 1.3; letter-spacing: -0.2px; }
  .cta { position: absolute; left: 44px; top: 227px; }
  .slab { position: absolute; right: 57.5px; top: 116px; width: 479px; height: 361px; background: var(--color-tar-soft); border-radius: var(--radius-lg); }
  .addons { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin: 24px 0 0; padding: 0; list-style: none; }
  .addon {
    display: flex; gap: 14px; align-items: flex-start; height: 178px; padding: 48px 20px; overflow: hidden;
    border: var(--hairline) solid var(--color-tar); border-radius: var(--radius-md); background: var(--color-paper);
  }
  .icon-wrap { flex: none; width: 178px; height: 160px; display: grid; place-items: center; }
  .icon { width: 166px; height: 146px; border-radius: var(--radius-lg); transform: rotate(-5deg); }
  .details { display: flex; flex-direction: column; gap: 8px; line-height: 1.3; }
  .details h3 { font-size: var(--text-lg); font-weight: 700; letter-spacing: -0.24px; }
  .details a { font-size: var(--text-sm); letter-spacing: -0.14px; text-decoration: none; }
  .details a:hover { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 900px) {
    .tools { margin-top: 72px; }
    .featured { height: auto; padding: 32px 24px 0; display: flex; flex-direction: column; gap: 16px; }
    .badge, .title, .desc, .cta { position: static; }
    .badge, .cta { align-self: flex-start; }
    .title img { width: 100px; height: auto; } .word { font-size: 44px; }
    .slab { position: static; width: 100%; height: 200px; margin-top: 16px; border-radius: var(--radius-lg) var(--radius-lg) 0 0; }
    .addons { grid-template-columns: 1fr; }
    .icon-wrap { width: 110px; height: 110px; } .icon { width: 100px; height: 88px; }
    .addon { height: auto; padding: 24px 16px; }
  }
</style>
