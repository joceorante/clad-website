---
const links = [
  ["Products", "#products"],
  ["Use Cases", "#use-cases"],
  ["Pricing", "#pricing"],
  ["Updates", "#changelog"],
  ["About", "#about"],
];
---
<header class="header">
  <a class="logo" href="/" aria-label="Clad home">
    <img src="/assets/clad-logo.svg" alt="" width="103" height="35" />
  </a>
  <nav class="links" aria-label="Primary">
    {links.map(([label, href]) => <a href={href}>{label}</a>)}
  </nav>
  <div class="actions">
    <a class="btn" href="#login">Log in</a>
    <a class="btn btn--solid" href="#demo">Get demo</a>
  </div>
</header>

<style>
  .header {
    position: sticky; top: 0; z-index: 50;
    display: grid; grid-template-columns: 200px 1fr auto; align-items: center;
    height: var(--header-h); background: var(--color-paper);
    border-bottom: var(--hairline) solid var(--color-tar);
    transition: height .3s cubic-bezier(.2,.7,.2,1), box-shadow .3s;
  }
  .header.is-compact { height: 72px; box-shadow: 0 1px 0 var(--color-tar), 0 12px 30px -24px rgb(37 34 12 / .35); }
  .logo { height: 100%; display: grid; place-items: center; border-right: var(--hairline) solid var(--color-tar); }
  .logo img { transform-origin: center; transition: transform .3s cubic-bezier(.2,.7,.2,1); }
  .is-compact .logo img { transform: scale(.8); }
  .actions .btn { transition: padding .3s cubic-bezier(.2,.7,.2,1), line-height .3s cubic-bezier(.2,.7,.2,1), background-color .15s, color .15s; }
  .is-compact .actions .btn { padding: 7px 18px; line-height: 26px; }
  .links { display: flex; gap: 45px; padding-left: 32px; font-size: var(--text-ui); line-height: 1.2; letter-spacing: 0; }
  .links a { text-decoration: none; }
  .links a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .actions { display: flex; gap: 9px; padding-right: 55px; }
  @media (max-width: 1100px) { .links { gap: 28px; } .actions { padding-right: var(--gutter); } }
  @media (max-width: 900px) {
    .header, .header.is-compact { grid-template-columns: auto 1fr auto; height: 64px; }
    .logo { padding-inline: var(--gutter); border-right: 0; }
    .logo img, .is-compact .logo img { width: 76px; height: auto; transform: none; }
    .actions .btn, .is-compact .actions .btn { padding: 7px 16px; line-height: 26px; }
    .links { display: none; }
    .actions .btn:first-child { display: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>(".header");
  let compact = false;
  const update = () => {
    const y = window.scrollY;
    // hysteresis so it doesn't flicker around the threshold
    const next = compact ? y > 24 : y > 64;
    if (next !== compact && header) { compact = next; header.classList.toggle("is-compact", compact); }
  };
  window.addEventListener("scroll", update, { passive: true });
  update();
</script>
