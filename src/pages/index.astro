---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import LogoBand from "../components/LogoBand.astro";
import CtaBanner from "../components/CtaBanner.astro";
import ProductStory from "../components/ProductStory.astro";
import Testimonial from "../components/Testimonial.astro";
import Audiences from "../components/Audiences.astro";
import Changelog from "../components/Changelog.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
---
<Base title="Clad" description="Project management and billing software for building infrastructure.">
  <Header />
  <main>
    <Hero />
    <LogoBand />
    <CtaBanner />
    <ProductStory />
    <Testimonial />
    <Audiences />
    <section class="dark">
      <Changelog />
    </section>
    <Faq />
  </main>
  <Footer />
</Base>

<style>
  .dark { margin-top: 98px; padding: 104px 0; background: var(--color-tar); color: var(--color-paper); }
  @media (max-width: 900px) { .dark { margin-top: 64px; padding: 64px 0; } }
</style>
